{
  "schema_version": 1,
  "updated": "2026-05-28",
  "purpose": "Compact reusable KIT questions. Use IDs in conversation or docs, then ask only the exact short question needed.",
  "rules": [
    "Ask at most 1-2 questions before choosing a default path.",
    "Do not ask users to pick unfamiliar frameworks unless the choice changes product outcome, cost, risk, or launch behavior.",
    "If project facts are already aligned, do not ask for ritual confirmation.",
    "If archive or movement can lose current intent, ask before moving files."
  ],
  "sets": {
    "status_brief": [
      {
        "id": "SB1",
        "prompt": "当前状态是什么？",
        "record": "stage/progress/blockers"
      },
      {
        "id": "SB2",
        "prompt": "终点是什么？",
        "record": "definition_of_done/stop_gate"
      },
      {
        "id": "SB3",
        "prompt": "方向和旧档是否一致？",
        "record": "drift:none|minor|scope_expansion|direction_change|new_project_candidate"
      },
      {
        "id": "SB4",
        "prompt": "下一步能不能安全做？",
        "record": "next_safe_action/user_decision_required"
      }
    ],
    "archive_gate": [
      {
        "id": "AR1",
        "prompt": "这些文件是历史、证据、用户测试包，还是当前事实？",
        "record": "keep|archive|docs|evidence|test_user|test_ai"
      },
      {
        "id": "AR2",
        "prompt": "归档后会不会丢失当前入口或恢复路径？",
        "record": "active_entry_impact"
      },
      {
        "id": "AR3",
        "prompt": "这个新需求是在改当前项目，还是该重开项目？",
        "record": "drift_decision"
      },
      {
        "id": "AR4",
        "prompt": "真实用户测试材料和 AI 自测材料分清了吗？",
        "record": ".test/user vs .test/ai"
      }
    ],
    "object_classification": [
      {
        "id": "OC1",
        "prompt": "你要的是 skill、workflow、CLI、前后端产品、OMC 编排、OpenCLI 自动化、SDK 集成、纯 MD 框架，还是设计原型？",
        "record": "primary_object"
      },
      {
        "id": "OC2",
        "prompt": "你要复用 AI 行为，还是交付一个可运行软件？",
        "record": "skill_or_runtime"
      },
      {
        "id": "OC3",
        "prompt": "这是一次性实验，还是以后要每天/每周稳定跑？",
        "record": "oneoff_or_stable_workflow"
      }
    ],
    "framework_route": [
      {
        "id": "FR1",
        "prompt": "这个选择会影响产品效果、维护成本或上线门禁吗？",
        "record": "route_tradeoff"
      },
      {
        "id": "FR2",
        "prompt": "现在还能反悔，还是一开工就会变贵？",
        "record": "reversibility/no_return_point"
      }
    ],
    "browser_image_live": [
      {
        "id": "BI1",
        "prompt": "是否需要登录态、cookie、账号 session 或绑定浏览器？",
        "record": "browser_auth_route"
      },
      {
        "id": "BI2",
        "prompt": "具体生图点是什么？",
        "record": "image_points/provider/approval"
      },
      {
        "id": "BI3",
        "prompt": "会不会真实写入、提交、发布或外发？",
        "record": "live_action_gate"
      }
    ],
    "hardcoded_assumptions": [
      {
        "id": "HA1",
        "prompt": "这个路径、端口、账号 ID、模型名是不是只在你电脑上成立？",
        "record": "config_or_contract"
      },
      {
        "id": "HA2",
        "prompt": "这里是示例、配置、密钥，还是产品事实？",
        "record": "example|config|secret|fact"
      }
    ],
    "scale_assessment": [
      {
        "id": "SCALE1",
        "prompt": "这个项目预计多久完成？是几小时的脚本、几天的组件，还是几周的产品？",
        "record": "quick|standard|deep"
      },
      {
        "id": "SCALE2",
        "prompt": "这个需求是一次性的快速验证，还是需要长期维护的稳定交付物？",
        "record": "oneoff|maintained"
      },
      {
        "id": "SCALE3",
        "prompt": "是否需要多轮迭代或对照实验来验证效果？",
        "record": "experiment_needed|no_experiment"
      }
    ],
    "user_confirmation": [
      {
        "id": "UC1",
        "prompt": "请确认当前 PRD：方向是否正确？有无遗漏？",
        "record": "prd_confirmed|modify|regenerate"
      },
      {
        "id": "UC2",
        "prompt": "请确认当前 SPEC：技术方案是否可行？验收标准是否清晰？",
        "record": "spec_confirmed|modify|regenerate"
      },
      {
        "id": "UC3",
        "prompt": "请确认当前 CHECKLIST：任务是否完整？优先级是否合理？",
        "record": "checklist_confirmed|modify|regenerate"
      },
      {
        "id": "UC4",
        "prompt": "连续未确认，是否跳过当前阶段或终止流程？",
        "record": "skip|terminate|continue"
      }
    ],
    "pm_audit": [
      {
        "id": "PM1",
        "prompt": "目标用户是否明确？解决什么痛点？",
        "record": "target_user|pain_point|vague"
      },
      {
        "id": "PM2",
        "prompt": "范围是否有蔓延？当前阶段是否包含不属于此阶段的内容？",
        "record": "scope_creep|clean"
      },
      {
        "id": "PM3",
        "prompt": "验收标准是否可观测？（如'加载时间<2秒'而非'好用'）",
        "record": "observable|vague_acceptance"
      },
      {
        "id": "PM4",
        "prompt": "技术风险是否记录？依赖项、无返回点、已知风险？",
        "record": "risks_documented|missing_risks"
      },
      {
        "id": "PM5",
        "prompt": "是否有 media-processing 技能？视频/图片/音频处理的安全风险是否评估？",
        "record": "media_risk_assessed|no_media"
      }
    ],
    "model_selection": [
      {
        "id": "UC-MODEL1",
        "prompt": "你当前可用的 AI 模型有哪些？（Claude / Codex / GPT / 其他）",
        "record": "available_models"
      },
      {
        "id": "UC-MODEL2",
        "prompt": "你的月度预算或 token 配额大约多少？",
        "record": "budget_quota"
      },
      {
        "id": "UC-MODEL3",
        "prompt": "项目中最关键的环节是什么？（代码质量 / 生图效果 / 长文本分析 / 速度）",
        "record": "critical_factor"
      },
      {
        "id": "UC-MODEL4",
        "prompt": "你是否接受多模型组合方案？（规划用一个模型，执行用另一个）",
        "record": "accept_multi_model|single_model_only"
      },
      {
        "id": "UC-MODEL5",
        "prompt": "你对 vibe coding 的接受度如何？（直接生成代码 vs 先详细设计再编码）",
        "record": "vibe_coding_acceptance"
      }
    ]
  }
}
